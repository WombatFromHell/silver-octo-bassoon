# fish: keep only the critical files; everything else is
# regeneratable via clean_fish (fisher update).
Configs/fish/.config/fish/*
!Configs/fish/.config/fish/config.fish
!Configs/fish/.config/fish/fish_plugins
!Configs/fish/.config/fish/sources.fish
!Configs/fish/.config/fish/helpers/
Configs/fish/.config/fish/helpers/*
!Configs/fish/.config/fish/helpers/*.fish
