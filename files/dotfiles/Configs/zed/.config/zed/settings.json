{
  "diagnostics": {
    "inline": {
      "enabled": true,
      "update_debounce_ms": 250,
      "padding": 4,
      "min_column": 0,
      "max_severity": null,
    },
  },
  "cli_default_open_behavior": "existing_window",
  "context_servers": {},
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true,
      "allow_fs_write_all": true,
      "network_hosts": [
        "pypi.org",
        "*.pythonhosted.org",
        "nodejs.org",
        "*.nodejs.org",
        "flakehub.com"
      ]
    },
    "show_turn_stats": true,
    "auto_compact": {
      "enabled": true,
    },
    "tool_permissions": {
      "tools": {
        "skill": {
          "default": "allow",
        },
        "fetch": {
          "default": "allow",
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^nix\\s+flake(\\s|$)",
            },
            {
              "pattern": "^head\\b",
            },
          ],
        },
      },
    },
    "default_model": {
      "provider": "llamacpp",
      "model": "qwen3.8-27b",
    },
    "favorite_models": [],
    "default_profile": "write",
    "model_parameters": [],
  },
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "git_panel": {
    "dock": "left",
  },
  "lsp": {
    "nixd": {
      "binary": {
        "path": "~/.nix-profile/bin/nixd",
      },
    },
    "nil": {
      "binary": {
        "path": "~/.nix-profile/bin/nil",
      },
      "initialization_options": {
        "nix": {
          "flake": {
            "autoArchive": false,
          },
        },
      },
    },
  },
  "languages": {
    "Nix": {
      "language_servers": ["nixd", "nil"],
      "formatter": {
        "external": {
          "command": "alejandra",
          "arguments": ["--quiet", "--"],
        },
      },
      "format_on_save": "on",
    },
    "Lua": {
      "tab_size": 2,
      "hard_tabs": false,
      "auto_indent": "syntax_aware",
      "auto_indent_on_paste": true,
      "use_on_type_format": false,
    },
    "Python": {
      "language_servers": ["ty"],
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "auto_indent": "syntax_aware",
      "auto_indent_on_paste": true,
    },
  },
  "language_models": {
    "opencode": {
      "show_zen_models": false,
      "show_go_models": true,
    },
    "openai_compatible": {
      "llamacpp": {
        "api_url": "http://127.0.0.1:9931/v1",
        "available_models": [
          {
            "name": "qwen3.8-27b",
            "display_name": "Qwen3.8-27B",
            "max_tokens": 131072,
          },
        ],
      },
    },
  },
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "fish",
        "args": ["-l"],
      },
    },
  },
  "auto_update": false,
  "tab_size": 2,
  "hard_tabs": false,
  "show_whitespaces": "trailing",
  "vim_mode": true,
  "buffer_font_size": 15.0,
  "ui_font_size": 16.0,
  "ui_font_family": "Noto Sans",
  "buffer_font_family": "FiraCode Nerd Font",
  "theme": "Catppuccin Mocha",
  "format_on_save": "on",
  "load_direnv": "direct",
}
