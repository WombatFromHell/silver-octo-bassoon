keybinds clear-defaults=true {
    // ponytail: default_mode "normal" — global shortcuts work in normal mode.
    // autolock plugin handles TUI editors. Ctrl-Shift-G toggles locked mode.
    // everything behind Ctrl-s (tmux mode) except global navigation shortcuts.
    normal {
        bind "Ctrl G" {
            MessagePlugin "autolock" {
                payload "toggle"
            }
        }
    }

    locked {
        bind "Ctrl s" {
            Write 19
        }
        bind "Ctrl G" {
            MessagePlugin "autolock" {
                payload "toggle"
            }
            SwitchToMode "normal"
        }
    }
    // ── tmux mode: the primary interface ──────────────────────────────
    // chaining keys stay in tmux; destructive/creative keys exit.
    tmux {
        // chaining: stay in tmux for rapid repeated use
        bind "h" {
            MoveFocus "left"
        }
        bind "j" {
            MoveFocus "down"
        }
        bind "k" {
            MoveFocus "up"
        }
        bind "l" {
            MoveFocus "right"
        }
        bind "n" {
            GoToNextTab
        }
        bind "o" {
            FocusNextPane
        }
        // pane creation (exit tmux)
        bind "p" {
            NewPane
            SwitchToMode "normal"
        }
        bind "s" {
            NewPane "down"
            SwitchToMode "normal"
        }
        bind "-" {
            NewPane "down"
            SwitchToMode "normal"
        }
        bind "v" {
            NewPane "right"
            SwitchToMode "normal"
        }
        bind "|" {
            NewPane "right"
            SwitchToMode "normal"
        }
        // tab creation and navigation (exit tmux)
        bind "c" {
            NewTab
            SwitchToMode "normal"
        }
        // Embeds the pane if floating, then breaks it out into a new tab
        bind "t" { TogglePaneEmbedOrFloating; BreakPane; SwitchToMode "normal"; }
        bind "H" {
            GoToPreviousTab
            SwitchToMode "normal"
        }
        bind "L" {
            GoToNextTab
            SwitchToMode "normal"
        }
        bind "1" {
            GoToTab 1
            SwitchToMode "normal"
        }
        bind "2" {
            GoToTab 2
            SwitchToMode "normal"
        }
        bind "3" {
            GoToTab 3
            SwitchToMode "normal"
        }
        bind "4" {
            GoToTab 4
            SwitchToMode "normal"
        }
        bind "5" {
            GoToTab 5
            SwitchToMode "normal"
        }
        bind "6" {
            GoToTab 6
            SwitchToMode "normal"
        }
        bind "7" {
            GoToTab 7
            SwitchToMode "normal"
        }
        bind "8" {
            GoToTab 8
            SwitchToMode "normal"
        }
        bind "9" {
            GoToTab 9
            SwitchToMode "normal"
        }
        // closing and toggling (exit tmux)
        bind "x" {
            CloseFocus
            SwitchToMode "normal"
        }
        bind "Ctrl x" {
            CloseTab
            SwitchToMode "normal"
        }
        bind "z" {
            ToggleFocusFullscreen
            SwitchToMode "normal"
        }
        bind "w" {
            ToggleFloatingPanes
            SwitchToMode "normal"
        }
        bind "e" {
            TogglePaneEmbedOrFloating
            SwitchToMode "normal"
        }
        bind "i" {
            TogglePanePinned
            SwitchToMode "normal"
        }
        bind "f" {
            TogglePaneFrames
            SwitchToMode "normal"
        }
        // layout
        bind "space" {
            NextSwapLayout
            SwitchToMode "normal"
        }
        // rename
        bind "," {
            SwitchToMode "renametab"
            TabNameInput 0
        }
        // session/layout/plugins
        bind "d" {
            Detach
        }
        bind "Ctrl o" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "Ctrl l" {
            LaunchOrFocusPlugin "zellij:layout-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "Ctrl c" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "Ctrl p" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        // literal key passthrough
        bind "Ctrl s" {
            Write 19
            SwitchToMode "normal"
        }
        bind "Ctrl b" {
            Write 2
            SwitchToMode "normal"
        }
        bind "Ctrl ]" {
            EditScrollback
            SwitchToMode "normal"
        }
        // quit
        bind "Ctrl q" {
            Quit
        }
        // sub-mode entries
        bind "r" {
            SwitchToMode "resize"
        }
        bind "m" {
            SwitchToMode "move"
        }
        bind "[" {
            SwitchToMode "scroll"
        }
        // exit to normal
        bind "esc" {
            SwitchToMode "normal"
        }
    }
    // ── resize sub-mode ──────────────────────────────────────────────
    // ponytail: inverted — lowercase decreases, uppercase increases.
    // stays in resize for chaining; esc returns to tmux.
    resize {
        bind "h" {
            Resize "Decrease left"
        }
        bind "j" {
            Resize "Decrease down"
        }
        bind "k" {
            Resize "Decrease up"
        }
        bind "l" {
            Resize "Decrease right"
        }
        bind "H" {
            Resize "Increase left"
        }
        bind "J" {
            Resize "Increase down"
        }
        bind "K" {
            Resize "Increase up"
        }
        bind "L" {
            Resize "Increase right"
        }
        bind "+" {
            Resize "Increase"
        }
        bind "-" {
            Resize "Decrease"
        }
        bind "=" {
            Resize "Increase"
        }
        bind "esc" {
            SwitchToMode "tmux"
        }
    }
    // ── move sub-mode ────────────────────────────────────────────────
    // stays in move for chaining; esc returns to tmux.
    move {
        bind "h" {
            MovePane "left"
        }
        bind "j" {
            MovePane "down"
        }
        bind "k" {
            MovePane "up"
        }
        bind "l" {
            MovePane "right"
        }
        bind "n" {
            MovePane
        }
        bind "p" {
            MovePaneBackwards
        }
        bind "tab" {
            MovePane
        }
        bind "esc" {
            SwitchToMode "tmux"
        }
    }
    // ── scroll mode ──────────────────────────────────────────────────
    scroll {
        bind "Ctrl u" {
            HalfPageScrollUp
        }
        bind "Ctrl d" {
            HalfPageScrollDown
        }
        bind "PageUp" {
            PageScrollUp
        }
        bind "PageDown" {
            PageScrollDown
        }
        bind "e" {
            EditScrollback
            SwitchToMode "normal"
        }
        bind "Ctrl s" {
            Write 19
            SwitchToMode "normal"
        }
        bind "Ctrl ]" {
            EditScrollback
            SwitchToMode "normal"
        }
        bind "s" {
            SwitchToMode "entersearch"
            SearchInput 0
        }
    }
    // ── search mode ──────────────────────────────────────────────────
    search {
        bind "v" {
            SwitchToMode "normal"
        }
        bind "y" {
            SwitchToMode "normal"
        }
        bind "c" {
            SearchToggleOption "CaseSensitivity"
        }
        bind "n" {
            Search "down"
        }
        bind "o" {
            SearchToggleOption "WholeWord"
        }
        bind "p" {
            Search "up"
        }
        bind "w" {
            SearchToggleOption "Wrap"
        }
    }
    entersearch {
        bind "Ctrl c" {
            SwitchToMode "scroll"
        }
        bind "esc" {
            SwitchToMode "scroll"
        }
        bind "enter" {
            SwitchToMode "search"
        }
    }
    renametab {
        bind "esc" {
            UndoRenameTab
            SwitchToMode "tmux"
        }
    }
    renamepane {
        bind "esc" {
            UndoRenamePane
            SwitchToMode "tmux"
        }
    }
    // ── legacy modes: kept for plugin compatibility, no keybind entries ──
    pane {

    }
    tab {

    }
    session {

    }
    // ── global shortcuts ─────────────────────────────────────────────
    // Ctrl-Alt-hjkl: pane navigation (free in neovim/helix).
    // Alt-h/l: tab switching (free in neovim/helix).
    // Alt-j/k: free for editors (line movement in helix/lazyvim).
    // Alt-arrow: strict pane navigation (no tab fallback).
    // Alt-Shift-hjkl: resize focused pane.
    shared_except "locked" {
        bind "Ctrl G" {
            SwitchToMode "locked"
        }
        // pane navigation
        bind "Ctrl Alt h" {
            MoveFocus "left"
        }
        bind "Ctrl Alt j" {
            MoveFocus "down"
        }
        bind "Ctrl Alt k" {
            MoveFocus "up"
        }
        bind "Ctrl Alt l" {
            MoveFocus "right"
        }
        // tab switching
        bind "Alt h" {
            GoToPreviousTab
        }
        bind "Alt l" {
            GoToNextTab
        }
        bind "Alt Left" {
            MoveFocus "left"
        }
        bind "Alt Down" {
            MoveFocus "down"
        }
        bind "Alt Up" {
            MoveFocus "up"
        }
        bind "Alt Right" {
            MoveFocus "right"
        }
        // quick resize shortcuts for splits
        bind "Alt =" {
            Resize "Increase"
        }
        bind "Alt -" {
            Resize "Decrease"
        }
        bind "Alt Shift h" {
            Resize "Increase Right"
        }
        bind "Alt Shift l" {
            Resize "Decrease Right"
        }
        bind "Alt Shift j" {
            Resize "Decrease Up"
        }
        bind "Alt Shift k" {
            Resize "Increase Up"
        }
    }
    // scroll mode entry from anywhere (except locked, tmux, scroll, search)
    shared_except "locked" "tmux" "scroll" "search" {
        bind "Ctrl PageUp" {
            SwitchToMode "scroll"
        }
        bind "Ctrl PageDown" {
            SwitchToMode "scroll"
        }
    }
    // tmux mode entry from anywhere (except locked, tmux, scroll, search)
    shared_except "locked" "tmux" "scroll" "search" {
        bind "Ctrl s" {
            SwitchToMode "tmux"
        }
    }
    // enter/escape → normal from most modes
    shared_except "normal" "locked" "entersearch" {
        bind "enter" {
            SwitchToMode "normal"
        }
    }
    shared_except "normal" "locked" "entersearch" "renametab" "renamepane" "tmux" "resize" "move" {
        bind "esc" {
            SwitchToMode "normal"
        }
    }
    // ctrl-c exits rename and scroll/search
    shared_among "renametab" "renamepane" {
        bind "Ctrl c" {
            SwitchToMode "normal"
        }
    }
}
plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    strider location="zellij:strider"
    autolock location="https://github.com/fresh2dev/zellij-autolock/releases/latest/download/zellij-autolock.wasm" {
        is_enabled true
        triggers "ssh|fzf|zoxide|atuin"
        reaction_seconds "1.0"
    }
}
load_plugins {
    autolock
}
theme "catppuccin-macchiato"
default_mode "normal"
default_shell "fish.sh"
default_layout "compact"
simplified_ui true
stacked_resize true
mouse_mode true
pane_frames false
on_force_close "detach"
scroll_buffer_size 10000
scrollback_editor "edit.sh"
copy_on_select true
session_serialization false
pane_frame_serialization false
show_startup_tips false
