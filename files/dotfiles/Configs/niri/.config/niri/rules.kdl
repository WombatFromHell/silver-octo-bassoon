// https://yalter.github.io/niri/Configuration:-Window-Rules
window-rule {
    match app-id="steam" title="^notificationtoasts_\\d+_desktop$"
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

// fallback to desktop
window-rule {
    match app-id="steam" title="Steam Big Picture Mode"
    open-fullscreen true
    open-focused true
    open-on-workspace "alt"
}

// default to external monitor first (if connected)
window-rule {
    match app-id="steam" title="Steam Big Picture Mode"
    open-fullscreen true
    open-focused true
    open-on-workspace "gamescope"
}

window-rule {
    match app-id="gamescope"
    open-fullscreen true
    open-focused true
    open-on-workspace "alt"
}

window-rule {
    match app-id="gamescope"
    open-fullscreen true
    open-focused true
    open-on-workspace "gamescope"
}

window-rule {
    match app-id="steam_app_default"
    open-fullscreen true
    open-focused true
    open-on-workspace "gamescope"
}

window-rule {
    match app-id="steam_app_default"
    open-fullscreen true
    open-focused true
    open-on-workspace "alt"
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id="firefox$" title="^Picture-in-Picture$"
    open-floating true
}
window-rule {
    match app-id="yad"
    open-floating true
}
window-rule {
    match app-id="org.kde.kcalc" title="^KCalc$"
    default-column-width {
        fixed 500
    }
    default-window-height {
        fixed 400
    }
    open-floating true
}

layer-rule {
  match namespace="dms:blurwallpaper"
  place-within-backdrop true
}

window-rule {
    match app-id="^org\\.keepassxc\\.KeePassXC$"
    match app-id="^org\\.gnome\\.World\\.Secrets$"
    block-out-from "screen-capture"
 // block-out-from "screencast"
}

// float deletion progress dialogs of Dolphin like Transfers
window-rule {
    match app-id="org.kde.dolphin" title="^Deleting"
    open-floating true
}

window-rule {
    match app-id="org.kde.dolphin" title="^Copying.* — Dolphin$"
    open-floating true
}

window-rule {
    match app-id="org.kde.dolphin" title="^Moving.* — Dolphin$"
    open-floating true
}
